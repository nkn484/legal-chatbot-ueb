{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.example.invalid/legal-chatbot/events/v1/common.schema.json",
  "title": "Legal chatbot event common values",
  "$defs": {
    "Id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,63}$"
    },
    "HashValue": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "Revision": {
      "type": "integer",
      "minimum": 1
    },
    "ReasonCode": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]{1,127}$"
    },
    "Count": {
      "type": "integer",
      "minimum": 0
    }
  }
}
