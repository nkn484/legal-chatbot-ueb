{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.example.invalid/legal-chatbot/events/v1/envelope.schema.json",
  "title": "Custom legal event envelope v1 (not CloudEvents AMQP)",
  "$defs": {
    "Envelope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "message_id": {
          "$ref": "common.schema.json#/$defs/Id"
        },
        "message_kind": {
          "type": "string",
          "enum": [
            "EVENT",
            "COMMAND"
          ]
        },
        "message_type": {
          "type": "string",
          "pattern": "^legal\\.[a-z]+(?:\\.[a-z]+)+\\.v1$"
        },
        "schema_version": {
          "const": "1.0.0"
        },
        "occurred_at": {
          "type": "string",
          "format": "date-time"
        },
        "producer_service": {
          "type": "string",
          "pattern": "^[a-z]+(?:-[a-z]+)*-service$"
        },
        "producer_service_version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][A-Za-z0-9.-]+)?$"
        },
        "aggregate_type": {
          "type": "string",
          "pattern": "^[A-Z][A-Za-z0-9]+$"
        },
        "aggregate_id": {
          "$ref": "common.schema.json#/$defs/Id"
        },
        "aggregate_revision": {
          "$ref": "common.schema.json#/$defs/Revision"
        },
        "ordering_key": {
          "$ref": "common.schema.json#/$defs/Id"
        },
        "correlation_id": {
          "$ref": "common.schema.json#/$defs/Id"
        },
        "causation_id": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,63}$"
        },
        "traceparent": {
          "type": "string",
          "pattern": "^[0-9a-f]{2}-[0-9a-f]{32}-[0-9a-f]{16}-[0-9a-f]{2}$"
        },
        "payload_hash": {
          "$ref": "common.schema.json#/$defs/HashValue",
          "description": "SHA-256 over project canonical JSON of data: UTF-8, recursively sorted object keys, separators comma/colon without insignificant whitespace; strings/integers/booleans/null only, arrays retain order, floats forbidden. This is not RFC JCS."
        },
        "data": {
          "type": "object"
        }
      },
      "required": [
        "message_id",
        "message_kind",
        "message_type",
        "schema_version",
        "occurred_at",
        "producer_service",
        "producer_service_version",
        "aggregate_type",
        "aggregate_id",
        "aggregate_revision",
        "ordering_key",
        "correlation_id",
        "payload_hash",
        "data"
      ]
    }
  }
}
