{
  "$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://schemas.example.invalid/legal-chatbot/v1/index.schema.json","title":"Index projection exchanges","description":"Version-neutral additive index-service exchanges. ACTIVE is an operational projection, not legal truth; VECTOR and HYBRID are LATER modes.","x-owner":"index-service","$ref":"#/$defs/IndexProjection",
