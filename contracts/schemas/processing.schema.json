{
  "$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://schemas.example.invalid/legal-chatbot/v1/processing.schema.json","title":"Processing exchanges","description":"Version-neutral additive processing-service exchanges; source content remains untrusted.","x-owner":"processing-service","$ref":"#/$defs/Job",
  "$defs":{
    "ArtifactRef":{"type":"object","properties":{"artifact_id":{"$ref":"common.schema.json#/$defs/Id"},"artifact_hash":{"$ref":"common.schema.json#/$defs/HashValue"}},"required":["artifact_id","artifact_hash"],"additionalProperties":false},
    "CanonicalLocator":{"type":"object","properties":{"page":{"type":"integer","minimum":1},"article":{"type":"string","minLength":1},"clause":{"type":"string","minLength":1},"point":{"type":"string","minLength":1},"character_start":{"type":"integer","minimum":0},"character_end":{"type":"integer","minimum":0}},"additionalProperties":false,"anyOf":[{"required":["page"]},{"required":["article"]},{"required":["clause"]},{"required":["point"]},{"required":["character_start"]},{"required":["character_end"]}]},
    "Job":{"type":"object","properties":{"job_id":{"$ref":"common.schema.json#/$defs/Id"},"job_type":{"type":"string","minLength":1},"version_id":{"$ref":"common.schema.json#/$defs/Id"},"input_hash":{"$ref":"common.schema.json#/$defs/HashValue"},"attempt":{"type":"integer","minimum":1},"status":{"type":"string","enum":["QUEUED","RUNNING","SUCCEEDED","FAILED","CANCELLED"]},"created_at":{"$ref":"common.schema.json#/$defs/Timestamp"},"started_at":{"$ref":"common.schema.json#/$defs/Timestamp"},"finished_at":{"$ref":"common.schema.json#/$defs/Timestamp"},"output_artifacts":{"type":"array","items":{"$ref":"#/$defs/ArtifactRef"}},"failure_code":{"$ref":"common.schema.json#/$defs/ReasonCode"}},"required":["job_id","job_type","version_id","input_hash","attempt","status","created_at"],"additionalProperties":false,"allOf":[{"if":{"properties":{"status":{"const":"SUCCEEDED"}},"required":["status"]},"then":{"required":["finished_at","output_artifacts"]}},{"if":{"properties":{"status":{"const":"FAILED"}},"required":["status"]},"then":{"required":["finished_at","failure_code"]}}]},
    "Chunk":{"type":"object","properties":{"chunk_id":{"$ref":"common.schema.json#/$defs/Id"},"version_id":{"$ref":"common.schema.json#/$defs/Id"},"revision":{"$ref":"common.schema.json#/$defs/Revision"},"status":{"type":"string","enum":["AVAILABLE","QUARANTINED","REVOKED"]},"content_trust":{"const":"UNTRUSTED_SOURCE"},"content_text":{"type":"string"},"content_hash":{"$ref":"common.schema.json#/$defs/HashValue"},"locator":{"$ref":"#/$defs/CanonicalLocator"},"ordinal":{"type":"integer","minimum":0},"lineage":{"$ref":"common.schema.json#/$defs/LineageRef"}},"required":["chunk_id","version_id","revision","status","content_trust","content_text","content_hash","locator","ordinal","lineage"],"additionalProperties":false}
  }
}
