{
  "$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://schemas.example.invalid/legal-chatbot/v1/document.schema.json","title":"Document exchanges","description":"Version-neutral additive document-service exchanges; corrections create a new immutable version by service invariant.","x-owner":"document-service","$ref":"#/$defs/Document",
  "$defs":{
    "CanonicalLegalMetadata":{"type":"object","properties":{"official_title":{"type":"string","minLength":1},"document_number":{"type":"string","minLength":1},"canonical_url":{"type":"string","format":"uri"},"jurisdiction_code":{"type":"string","minLength":1},"document_class_code":{"type":"string","minLength":1},"issuer_code":{"type":"string","minLength":1}},"required":["official_title","document_number","canonical_url"],"additionalProperties":false},
    "EffectConfirmation":{"type":"object","properties":{"confirmed":{"const":true},"confirmed_at":{"$ref":"common.schema.json#/$defs/Timestamp"},"confirmed_by":{"$ref":"common.schema.json#/$defs/ActorRef"},"provenance":{"$ref":"common.schema.json#/$defs/LineageRef"}},"required":["confirmed","confirmed_at","confirmed_by","provenance"],"additionalProperties":false},
    "OriginalObjectManifestRef":{"type":"object","description":"Opaque document-owned manifest reference; never storage location or credential.","properties":{"manifest_id":{"$ref":"common.schema.json#/$defs/Id"},"manifest_hash":{"$ref":"common.schema.json#/$defs/HashValue"}},"required":["manifest_id","manifest_hash"],"additionalProperties":false},
    "Version":{"type":"object","properties":{"version_id":{"$ref":"common.schema.json#/$defs/Id"},"document_id":{"$ref":"common.schema.json#/$defs/Id"},"revision":{"$ref":"common.schema.json#/$defs/Revision"},"status":{"type":"string","enum":["INGESTED","PROCESSING","READY_FOR_REVIEW","APPROVED","REJECTED","FAILED"]},"content_hash":{"$ref":"common.schema.json#/$defs/HashValue"},"original_manifest":{"$ref":"#/$defs/OriginalObjectManifestRef"},"provenance":{"$ref":"common.schema.json#/$defs/LineageRef"},"created_at":{"$ref":"common.schema.json#/$defs/Timestamp"}},"required":["version_id","document_id","revision","status","content_hash","original_manifest","provenance","created_at"],"additionalProperties":false},
    "Document":{"type":"object","properties":{"document_id":{"$ref":"common.schema.json#/$defs/Id"},"status":{"type":"string","enum":["DRAFT","PUBLISHED","UNPUBLISHED","ARCHIVED"]},"active":{"type":"boolean"},"current_version_id":{"$ref":"common.schema.json#/$defs/Id"},"metadata":{"$ref":"#/$defs/CanonicalLegalMetadata"},"effect_confirmation":{"$ref":"#/$defs/EffectConfirmation"},"revision":{"$ref":"common.schema.json#/$defs/Revision"},"changed_at":{"$ref":"common.schema.json#/$defs/Timestamp"}},"required":["document_id","status","active","metadata","revision","changed_at"],"additionalProperties":false,"allOf":[{"if":{"properties":{"active":{"const":true}},"required":["active"]},"then":{"properties":{"status":{"const":"PUBLISHED"}},"required":["status"]}},{"if":{"properties":{"status":{"const":"PUBLISHED"}},"required":["status"]},"then":{"required":["current_version_id","effect_confirmation"]}}]}
  }
}
