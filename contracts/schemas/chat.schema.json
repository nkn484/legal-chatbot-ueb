{
  "$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://schemas.example.invalid/legal-chatbot/v1/chat.schema.json","title":"Chat grounding exchanges","description":"Version-neutral additive chat-service exchanges. Grounding inputs use chunk IDs only, never source metadata.","x-owner":"chat-service","$ref":"#/$defs/Chat",
  "$defs":{"GroundedClaim":{"type":"object","properties":{"claim_id":{"$ref":"common.schema.json#/$defs/Id"},"text":{"type":"string","minLength":1},"chunk_ids":{"type":"array","minItems":1,"items":{"$ref":"common.schema.json#/$defs/Id"},"uniqueItems":true}},"required":["claim_id","text","chunk_ids"],"additionalProperties":false},"GroundedAnswer":{"type":"object","properties":{"grounded_answer_id":{"$ref":"common.schema.json#/$defs/Id"},"chat_id":{"$ref":"common.schema.json#/$defs/Id"},"context_id":{"$ref":"common.schema.json#/$defs/Id"},"snapshot_hash":{"$ref":"common.schema.json#/$defs/HashValue"},"outcome":{"type":"string","enum":["ANSWER","REFUSAL"]},"claims":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/GroundedClaim"}},"refusal":{"$ref":"common.schema.json#/$defs/Refusal"}},"required":["grounded_answer_id","chat_id","context_id","snapshot_hash","outcome"],"additionalProperties":false,"oneOf":[{"properties":{"outcome":{"const":"ANSWER"}},"required":["claims"],"not":{"required":["refusal"]}},{"properties":{"outcome":{"const":"REFUSAL"}},"required":["refusal"],"not":{"required":["claims"]}}]},"Chat":{"type":"object","properties":{"chat_id":{"$ref":"common.schema.json#/$defs/Id"},"conversation_id":{"$ref":"common.schema.json#/$defs/Id"},"request_hash":{"$ref":"common.schema.json#/$defs/HashValue"},"retrieval_id":{"$ref":"common.schema.json#/$defs/Id"},"grounded_answer_id":{"$ref":"common.schema.json#/$defs/Id"},"idempotency_key":{"type":"string","minLength":1},"status":{"type":"string","enum":["ACCEPTED","ANSWERED","REFUSED","FAILED","CANCELLED"]},"created_at":{"$ref":"common.schema.json#/$defs/Timestamp"},"completed_at":{"$ref":"common.schema.json#/$defs/Timestamp"},"refusal":{"$ref":"common.schema.json#/$defs/Refusal"}},"required":["chat_id","conversation_id","request_hash","idempotency_key","status","created_at"],"additionalProperties":false,"allOf":[{"if":{"properties":{"status":{"const":"ANSWERED"}},"required":["status"]},"then":{"required":["retrieval_id","grounded_answer_id","completed_at"]}},{"if":{"properties":{"status":{"const":"REFUSED"}},"required":["status"]},"then":{"required":["retrieval_id","grounded_answer_id","refusal","completed_at"]}}]}}
}
