{
  "$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://schemas.example.invalid/legal-chatbot/v1/retrieval.schema.json","title":"Retrieval exchanges","description":"Version-neutral additive retrieval-service exchanges; request binding, expiry and final eligibility checks are service invariants.","x-owner":"retrieval-service","$ref":"#/$defs/RetrievalRun",
  "$defs":{"EvidenceRef":{"type":"object","properties":{"evidence_id":{"$ref":"common.schema.json#/$defs/Id"},"chunk_id":{"$ref":"common.schema.json#/$defs/Id"},"version_id":{"$ref":"common.schema.json#/$defs/Id"},"index_id":{"$ref":"common.schema.json#/$defs/Id"},"rank":{"type":"integer","minimum":1},"score":{"type":"number"}},"required":["evidence_id","chunk_id","version_id","index_id","rank"],"additionalProperties":false},"RetrievalRun":{"type":"object","properties":{"retrieval_id":{"$ref":"common.schema.json#/$defs/Id"},"query_hash":{"$ref":"common.schema.json#/$defs/HashValue"},"context_id":{"$ref":"common.schema.json#/$defs/Id"},"index_id":{"$ref":"common.schema.json#/$defs/Id"},"config_hash":{"$ref":"common.schema.json#/$defs/HashValue"},"state":{"type":"string","enum":["RUNNING","SUFFICIENT","INSUFFICIENT","FAILED"]},"evidence":{"type":"array","items":{"$ref":"#/$defs/EvidenceRef"}},"refusal":{"$ref":"common.schema.json#/$defs/Refusal"},"reason_codes":{"type":"array","items":{"$ref":"common.schema.json#/$defs/ReasonCode"},"uniqueItems":true},"created_at":{"$ref":"common.schema.json#/$defs/Timestamp"},"completed_at":{"$ref":"common.schema.json#/$defs/Timestamp"}},"required":["retrieval_id","query_hash","context_id","index_id","config_hash","state","evidence","created_at"],"additionalProperties":false,"allOf":[{"if":{"properties":{"state":{"const":"SUFFICIENT"}},"required":["state"]},"then":{"properties":{"evidence":{"minItems":1}},"required":["completed_at"],"not":{"required":["refusal"]}}},{"if":{"properties":{"state":{"const":"INSUFFICIENT"}},"required":["state"]},"then":{"required":["refusal","completed_at"]}}]}}
}
