{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://schemas.example.invalid/legal-chatbot/v1/source-connector-port.schema.json",
  "title":"Source connector port exchanges",
  "description":"Version-neutral additive document-service source registry and neutral read-only port DTOs; not API, event, connector implementation, or legal authority.",
  "x-owner":"document-service",
  "$ref":"#/$defs/SourceSystemCatalog",
  "$defs":{
    "SourceSystemId":{"type":"string","enum":["VBQPPL","VNU","UEB"]},
    "ActiveSourceSystemId":{"const":"VBQPPL"},
    "OperationPolicy":{"type":"object","properties":{"access_mode":{"const":"READ_ONLY"},"enforcement":{"const":"DENY_BY_DEFAULT"},"operation_allowlist_status":{"const":"PENDING_VERIFICATION"},"allowed_operations":{"type":"array","maxItems":0,"items":{"type":"string"},"uniqueItems":true},"denied_operation_classes":{"type":"array","minItems":5,"maxItems":5,"items":{"type":"string","enum":["CREATE","UPDATE","REMOVE","DELETE","WRITE"]},"uniqueItems":true}},"required":["access_mode","enforcement","operation_allowlist_status","allowed_operations","denied_operation_classes"],"additionalProperties":false},
    "SourceSystem":{"type":"object","description":"ACTIVE is registry state only, not connector implementation or fetch success. Operational rollout priority is not legal hierarchy, effect, applicability, source credibility, retrieval rank, or conflict resolution.","properties":{"source_system_id":{"$ref":"#/$defs/SourceSystemId"},"display_name":{"type":"string","minLength":1},"lifecycle_status":{"type":"string","enum":["ACTIVE","PLANNED","DISABLED","RETIRED"]},"rollout_phase":{"type":"string","enum":["CORE","LATER"]},"rollout_priority":{"type":"integer","minimum":1,"maximum":3,"description":"Operational rollout order only; never legal authority or retrieval ranking."},"connector_implementation_status":{"const":"NOT_IMPLEMENTED"},"transport_profile":{"type":"string","enum":["SOAP_ASMX","NOT_CONFIGURED"]},"endpoint_url":{"type":"string","format":"uri"},"operation_policy":{"$ref":"#/$defs/OperationPolicy"},"description":{"type":"string","minLength":1}},"required":["source_system_id","display_name","lifecycle_status","rollout_phase","rollout_priority","connector_implementation_status","transport_profile","operation_policy","description"],"additionalProperties":false,"allOf":[{"oneOf":[{"properties":{"source_system_id":{"const":"VBQPPL"},"rollout_priority":{"const":1}}},{"properties":{"source_system_id":{"const":"VNU"},"rollout_priority":{"const":2}}},{"properties":{"source_system_id":{"const":"UEB"},"rollout_priority":{"const":3}}}]},{"if":{"properties":{"lifecycle_status":{"const":"ACTIVE"}},"required":["lifecycle_status"]},"then":{"properties":{"rollout_phase":{"const":"CORE"},"transport_profile":{"const":"SOAP_ASMX"}},"required":["endpoint_url"]}},{"if":{"properties":{"lifecycle_status":{"enum":["PLANNED","DISABLED","RETIRED"]}},"required":["lifecycle_status"]},"then":{"properties":{"rollout_phase":{"const":"LATER"},"transport_profile":{"const":"NOT_CONFIGURED"}},"not":{"required":["endpoint_url"]}}}]},
    "VBQPPLCurrent":{"allOf":[{"$ref":"#/$defs/SourceSystem"},{"properties":{"source_system_id":{"const":"VBQPPL"},"lifecycle_status":{"const":"ACTIVE"},"rollout_phase":{"const":"CORE"},"rollout_priority":{"const":1},"connector_implementation_status":{"const":"NOT_IMPLEMENTED"},"transport_profile":{"const":"SOAP_ASMX"},"endpoint_url":{"const":"https://ws.vbpl.vn/vbqppl.asmx"}},"required":["endpoint_url"]}]},
    "VNUCurrent":{"allOf":[{"$ref":"#/$defs/SourceSystem"},{"properties":{"source_system_id":{"const":"VNU"},"lifecycle_status":{"const":"PLANNED"},"rollout_phase":{"const":"LATER"},"rollout_priority":{"const":2},"connector_implementation_status":{"const":"NOT_IMPLEMENTED"},"transport_profile":{"const":"NOT_CONFIGURED"}},"not":{"required":["endpoint_url"]}}]},
    "UEBCurrent":{"allOf":[{"$ref":"#/$defs/SourceSystem"},{"properties":{"source_system_id":{"const":"UEB"},"lifecycle_status":{"const":"PLANNED"},"rollout_phase":{"const":"LATER"},"rollout_priority":{"const":3},"connector_implementation_status":{"const":"NOT_IMPLEMENTED"},"transport_profile":{"const":"NOT_CONFIGURED"}},"not":{"required":["endpoint_url"]}}]},
    "SourceDocumentRef":{"type":"object","description":"Future fetch provenance shape only; it neither publishes a version nor confirms legal effect.","properties":{"source_system_id":{"$ref":"#/$defs/ActiveSourceSystemId"},"source_external_id":{"type":"string","pattern":"^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"},"source_document_url":{"type":"string","format":"uri","pattern":"^https://ws\\.vbpl\\.vn(?:/|$)"},"source_updated_at":{"$ref":"common.schema.json#/$defs/Timestamp"},"fetched_at":{"$ref":"common.schema.json#/$defs/Timestamp"},"raw_payload_hash":{"$ref":"common.schema.json#/$defs/HashValue"},"mapping_version":{"type":"string","pattern":"^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"}},"required":["source_system_id","source_external_id","source_document_url","source_updated_at","fetched_at","raw_payload_hash","mapping_version"],"additionalProperties":false,"not":{"properties":{"source_document_url":{"const":"https://ws.vbpl.vn/vbqppl.asmx"}},"required":["source_document_url"]}},
    "SourceSystemCatalog":{"type":"object","properties":{"catalog_version":{"type":"string","minLength":1},"systems":{"type":"array","minItems":3,"maxItems":3,"prefixItems":[{"$ref":"#/$defs/VBQPPLCurrent"},{"$ref":"#/$defs/VNUCurrent"},{"$ref":"#/$defs/UEBCurrent"}],"items":false}},"required":["catalog_version","systems"],"additionalProperties":false},
    "SourceDiscoveryRequest":{"type":"object","properties":{"source_system_id":{"$ref":"#/$defs/ActiveSourceSystemId"},"cursor":{"type":"string","minLength":1},"page_size":{"type":"integer","minimum":1,"maximum":100}},"required":["source_system_id"],"additionalProperties":false},
    "SourceDiscoveryPage":{"type":"object","properties":{"source_system_id":{"$ref":"#/$defs/ActiveSourceSystemId"},"document_refs":{"type":"array","items":{"$ref":"#/$defs/SourceDocumentRef"}},"next_cursor":{"type":"string","minLength":1}},"required":["source_system_id","document_refs"],"additionalProperties":false},
    "SourceFetchRequest":{"type":"object","properties":{"source_system_id":{"$ref":"#/$defs/ActiveSourceSystemId"},"source_external_id":{"type":"string","pattern":"^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"}},"required":["source_system_id","source_external_id"],"additionalProperties":false},
    "PayloadRef":{"type":"object","properties":{"payload_id":{"$ref":"common.schema.json#/$defs/Id"},"payload_hash":{"$ref":"common.schema.json#/$defs/HashValue"}},"required":["payload_id","payload_hash"],"additionalProperties":false},
    "FetchedSourceDocument":{"type":"object","properties":{"source_ref":{"$ref":"#/$defs/SourceDocumentRef"},"payload_ref":{"$ref":"#/$defs/PayloadRef"},"content_type":{"type":"string","minLength":1},"fetched_at":{"$ref":"common.schema.json#/$defs/Timestamp"}},"required":["source_ref","payload_ref","content_type","fetched_at"],"additionalProperties":false}
  }
}
