  "$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://schemas.example.invalid/legal-chatbot/v1/citation.schema.json","title":"Citation exchanges","description":"Version-neutral additive citation-service exchanges; backend-owned validation and rendering.","x-owner":"citation-service","$ref":"#/$defs/Citation",
